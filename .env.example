# ==============================================================================
# DOCORA Studio — Environment Configuration Specification
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Authentication & PostgreSQL Database
# ------------------------------------------------------------------------------
# Public Supabase URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (Project Settings -> API -> Project API Keys -> anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Secret Key (Project Settings -> API -> service_role secret)
# CAUTION: Never expose this key to browser client bundles or commits.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Google Gemini API (Inference Engine)
# ------------------------------------------------------------------------------
# Google AI Studio Gemini API Key for server-side structured generation
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# Testing & Development Flags (Optional)
# ------------------------------------------------------------------------------
# Set to 'true' to disable automatic route redirects to /sign-in during headless E2E runs
DISABLE_AUTH_REDIRECT=false
